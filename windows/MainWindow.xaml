<Window
    x:Class="RivetHost.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RivetHost">

    <Grid x:Name="RootGrid" RowSpacing="0">
        <Grid.Resources>
            <LinearGradientBrush x:Key="DropZoneFill" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#0A000000" Offset="0"/>
                <GradientStop Color="#05000000" Offset="1"/>
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="DropZoneFillActive" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#140078D4" Offset="0"/>
                <GradientStop Color="#0A0078D4" Offset="1"/>
            </LinearGradientBrush>

            <DataTemplate x:Key="TransferTemplate" x:DataType="local:TransferItem">
                <Grid ColumnSpacing="12" Padding="10,10" CornerRadius="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Width="38" Height="38"
                        CornerRadius="10"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        HorizontalAlignment="Left" VerticalAlignment="Top">
                        <TextBlock
                            Text="{x:Bind DirectionGlyph, Mode=OneWay}"
                            FontSize="16" FontWeight="SemiBold"
                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <TextBlock
                            Text="{x:Bind Filename, Mode=OneWay}"
                            FontSize="14" FontWeight="SemiBold"
                            TextTrimming="CharacterEllipsis"/>
                        <TextBlock
                            Text="{x:Bind MessageText, Mode=OneWay}"
                            FontSize="12" Opacity="0.65"
                            TextTrimming="CharacterEllipsis"/>
                        <ProgressBar
                            Value="{x:Bind Progress, Mode=OneWay}"
                            Maximum="100"
                            Visibility="{x:Bind ProgressVisibility, Mode=OneWay}"
                            Height="3" CornerRadius="1.5"/>
                        <TextBlock
                            Text="打开所在文件夹"
                            FontSize="11"
                            Foreground="{ThemeResource SystemAccentColorLight1}"
                            Visibility="{x:Bind OpenFolderVisibility, Mode=OneWay}"/>
                    </StackPanel>

                    <StackPanel
                        Grid.Column="2" Spacing="3"
                        VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock
                            Text="{x:Bind StatusText, Mode=OneWay}"
                            FontSize="12" HorizontalAlignment="Right"/>
                        <TextBlock
                            Text="{x:Bind SizeStampText, Mode=OneWay}"
                            FontSize="11" Opacity="0.5" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>
            </DataTemplate>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- custom caption bar: identity only; system buttons own the corner -->
        <Grid x:Name="CaptionBar" Grid.Row="0" Padding="16,0,12,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock
                    Text="Shuttle"
                    FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock
                    x:Name="CaptionMachine"
                    FontSize="12" Opacity="0.55" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Padding="24,4,24,16" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <InfoBar
                x:Name="ErrorBar"
                Grid.Row="0"
                IsOpen="False" IsClosable="True"
                Severity="Error"/>

            <Grid Grid.Row="1" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Text="发给"
                    FontSize="13" Opacity="0.75"
                    VerticalAlignment="Center"/>
                <ComboBox
                    x:Name="TargetBox"
                    Grid.Column="1"
                    IsEditable="True"
                    PlaceholderText="对方的电脑名（在对方 Shuttle 标题栏可见）"
                    MinHeight="32"/>
            </Grid>

            <Border
                x:Name="DropZone"
                Grid.Row="2"
                Height="128" CornerRadius="12"
                Background="{StaticResource DropZoneFill}"
                BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                BorderThickness="1"
                AllowDrop="True"
                Tapped="DropZone_Tapped">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                    <FontIcon
                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                        Glyph="&#xE898;" FontSize="22" Opacity="0.8"/>
                    <TextBlock
                        x:Name="DropTitle"
                        FontSize="15" FontWeight="SemiBold"
                        HorizontalAlignment="Center"/>
                    <TextBlock
                        x:Name="DropSubtitle"
                        FontSize="12" Opacity="0.6"
                        HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="3">
                <TextBlock
                    x:Name="TransfersTitle"
                    FontSize="13" FontWeight="SemiBold" Opacity="0.8"
                    VerticalAlignment="Center"/>
                <Button
                    x:Name="ClearHistoryButton"
                    HorizontalAlignment="Right"
                    Style="{ThemeResource SubtleButtonStyle}"
                    Padding="8,4" FontSize="12"/>
            </Grid>

            <Grid Grid.Row="4">
                <ListView
                    x:Name="TransfersList"
                    ItemTemplate="{StaticResource TransferTemplate}"
                    SelectionMode="None"
                    IsItemClickEnabled="True"/>
                <TextBlock
                    x:Name="EmptyState"
                    FontSize="13" Opacity="0.45"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    TextAlignment="Center"/>
            </Grid>

            <Grid Grid.Row="5">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Ellipse x:Name="HealthDot" Width="8" Height="8"/>
                    <TextBlock x:Name="HealthText" FontSize="12" Opacity="0.7"/>
                </StackPanel>
                <Button
                    x:Name="SettingsButton"
                    HorizontalAlignment="Right"
                    Style="{ThemeResource SubtleButtonStyle}"
                    AutomationProperties.Name="Settings"
                    ToolTipService.ToolTip="设置">
                    <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE713;" FontSize="14"/>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Window>
