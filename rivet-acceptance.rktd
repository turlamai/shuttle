#hasheq(
 (version . 1)
 (requirements
  . (#hasheq((kind . unit) (platforms . (windows)))
     #hasheq((kind . bridge) (platforms . (windows)))
     #hasheq((kind . contract) (platforms . (windows)))
     #hasheq((kind . native-build) (platforms . (windows)))
     #hasheq((kind . release) (platforms . (windows)))))
 (suites
  . (#hasheq((id . backend-unit)
             (kind . unit)
             (platforms . (windows))
             (command . ("raco" "test" "app/backend.rkt"))
             (timeout-seconds . 300)
             (evidence . ()))
     #hasheq((id . mailbox-chain)
             (kind . bridge)
             (platforms . (windows))
             (command . ("racket" "-l" "racket/base" "-e"
                         "(require (submod \"app/backend.rkt\" test)) (test-main)"))
             (timeout-seconds . 600)
             (evidence . ()))
     #hasheq((id . schema-contract)
             (kind . contract)
             (platforms . (windows))
             (command . ("raco" "rivet" "schema" "check" "rivet-schema.json" "--json"))
             (timeout-seconds . 120)
             (evidence . ()))
     #hasheq((id . native-build)
             (kind . native-build)
             (platforms . (windows))
             (command . ("raco" "rivet" "build"))
             (timeout-seconds . 1800)
             (evidence . ()))
     #hasheq((id . release-update)
             (kind . release)
             (platforms . (windows))
             (command . ("racket" "scripts/acceptance/release-update.rkt"))
             (timeout-seconds . 900)
             (evidence . (".rivet/acceptance/release-update.json"))))))
